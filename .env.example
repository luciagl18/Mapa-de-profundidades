# Ejemplo de archivo .env para configuración
# Copiar este archivo a .env y ajustar los valores

# API Configuration
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# Data Source
DATA_SOURCE=binance
BASE_URL=https://api.binance.com/api/v3

# Analysis Parameters
DEFAULT_PRICE_LEVELS=10
DEFAULT_PRICE_DISTANCE=0.01

# Output
OUTPUT_DIR=output
SAVE_VISUALIZATIONS=true
